# Copy this file to .env.local and fill in the values. .env.local is ignored by Git: never commit a real key.
# Restart `yarn dev` after any change.

# URL of the Abricot backend (Express API)
API_URL=http://localhost:8000

# AI task generation: any provider with an OpenAI-compatible API (OpenAI, Mistral, Groq, OpenRouter, Ollama...).
# These variables are read on the server only: never add a NEXT_PUBLIC_ prefix, it would expose the key.
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Secret key of the provider (may stay empty for a local model such as Ollama)
AI_API_KEY=
# How to ask for JSON: json_schema (default), json_object or none. Try the next one if the provider answers a 400 error.
AI_RESPONSE_FORMAT=json_schema
